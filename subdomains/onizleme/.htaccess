# test.webina.com.tr / test2.webina.com.tr — prévisualisation des sites clients avant mise en ligne
# Chaque site client va dans son propre dossier : https://test.webina.com.tr/nom-du-client/
Options -Indexes
DirectoryIndex index.html index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.well-known/ - [L]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
</IfModule>
<IfModule mod_headers.c>
  # Jamais indexé par Google : les sites en préparation ne doivent pas apparaître dans les résultats
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>
