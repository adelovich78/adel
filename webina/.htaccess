# ==========================================================================
# Webina — public_html/.htaccess (site statique + API PHP)
# ==========================================================================
Options -Indexes -MultiViews
DirectoryIndex index.html index.php
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Laisser passer la validation SSL (AutoSSL / Let's Encrypt)
  RewriteRule ^\.well-known/ - [L]

  # HTTPS obligatoire + sans www (une seule redirection)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://webina.com.tr%{REQUEST_URI} [R=301,L,NE]

  # Anciennes pages .html -> nouvelles URL
  RewriteRule ^(services|secteurs|portfolio|contact|teklif)\.html$ /$1/ [R=301,L]
  RewriteRule ^index\.html$ / [R=301,L]

  # Bloquer fichiers cachés, sauvegardes, archives, journaux, sources
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(zip|rar|7z|tar|gz|tgz|bak|old|orig|save|swp|sql|log|ini|env|sh|py|md|lock|dist)$ - [F,NC,L]
  RewriteRule (^|/)(error_log|php_errors\.log|composer\.(json|lock)|package(-lock)?\.json|wp-config\.php)$ - [F,NC,L]

  # Robots qui sondent WordPress (le site n'en utilise pas)
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php) - [F,NC,L]
</IfModule>

# Pages d'erreur
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Cache : HTML et JSON toujours frais, ressources statiques 1 an
  <FilesMatch "\.(html|json|vcf)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  # Fiche contact de la carte de visite (/kart) : ouverte par Contacts sur iPhone et Android
  AddType "text/vcard; charset=utf-8" .vcf
</IfModule>
